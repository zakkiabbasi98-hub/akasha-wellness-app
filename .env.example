# ─────────────────────────────────────────────────────────────────────────────
# AKASHA — example configuration. PLACEHOLDERS ONLY.
#
# AKASHA does not read a .env file at runtime: Flutter configuration is passed
# at build time with --dart-define, which keeps secrets out of the repository and
# out of the APK. This file documents the accepted keys.
#
#   flutter build apk --release \
#     --dart-define=AKASHA_AI_ENDPOINT=https://<region>-<project>.cloudfunctions.net/akashaCompanion
#
# NEVER put a provider API key here. Keys belong on the server
# (firebase/functions — see docs/FIREBASE_SETUP.md).
# ─────────────────────────────────────────────────────────────────────────────

# Optional. Public URL of your AI companion function. Without it the companion
# runs its offline reflection mode and says so.
AKASHA_AI_ENDPOINT=https://us-central1-your-project.cloudfunctions.net/akashaCompanion

# Optional build metadata (informational only).
AKASHA_ENV=development
