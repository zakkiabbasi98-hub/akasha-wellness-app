<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="315"
                android:startColor="#FFFDF3F9"
                android:centerColor="#FFF6EDFB"
                android:endColor="#FFEDF4FD"
                android:type="linear" />
        </shape>
    </item>
    <item android:gravity="center" android:width="132dp" android:height="132dp">
        <bitmap android:gravity="center" android:src="@drawable/ic_launcher_foreground" />
    </item>
</layer-list>
