# ─────────────────────────────────────────────────────────────────────────────
# AKASHA Cloud Function — example environment
#
# PLACEHOLDERS ONLY. Copy this file to `.env`, replace the values locally, and
# NEVER commit the copy (it is git-ignored). Preferred for production:
#
#     firebase functions:secrets:set AI_PROVIDER_KEY
#
# which keeps the value in Secret Manager instead of a file.
# ─────────────────────────────────────────────────────────────────────────────

# API key for your model provider. Server-side only — the app never holds it.
AI_PROVIDER_KEY=your-provider-api-key-here

# Optional: point at any OpenAI-compatible chat-completions endpoint.
# AI_BASE_URL=https://api.openai.com/v1/chat/completions

# Optional: model identifier for that endpoint.
# AI_MODEL=gpt-4o-mini
