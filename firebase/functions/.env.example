# ─────────────────────────────────────────────────────────────────────────────
# AKASHA Cloud Function — example environment
#
# PLACEHOLDERS ONLY. Copy to `.env`, replace the values locally, and NEVER
# commit the copy (it is git-ignored). Preferred for production:
#
#     firebase functions:secrets:set AI_PROVIDER_KEY
#
# which keeps the value in Secret Manager instead of a file.
# ─────────────────────────────────────────────────────────────────────────────

# API key for your model provider. Server-side only — the app never holds it.
AI_PROVIDER_KEY=your-provider-api-key-here

# Optional: point at any OpenAI-compatible chat-completions endpoint.
# AI_BASE_URL=https://api.openai.com/v1/chat/completions

# Optional: model identifier for that endpoint.
# AI_MODEL=gpt-4o-mini

# ── CORS ─────────────────────────────────────────────────────────────────────
# Comma-separated allow-list of ORIGINS (scheme + host, no trailing slash).
# There is no wildcard: a browser origin not on this list is rejected with 403.
# Requests from the Android app send no Origin header and do not need an entry.
#
# Example: https://akasha.example.com,https://app.akasha.example.com
ALLOWED_ORIGINS=

# ── App Check ────────────────────────────────────────────────────────────────
# Set to `true` in production so every request must carry a valid Firebase App
# Check token (X-Firebase-AppCheck). Leave `false` until you have registered the
# Android app with Play Integrity in the Firebase console, otherwise every
# request will be rejected.
ENFORCE_APP_CHECK=false
